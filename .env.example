# Required to authorize daily Vercel Cron and manual synchronization.
# Generate a long random value. Never prefix secrets with NEXT_PUBLIC_.
CRON_SECRET=

# Vercel: connect a PRIVATE Blob store. Its project connection supplies
# BLOB_STORE_ID and managed OIDC credentials automatically.
# Outside Vercel, use this store's read-write token instead (optional locally).
BLOB_READ_WRITE_TOKEN=

# Required for full OpenAlex cursor pagination; saved browsing needs no key.
OPENALEX_API_KEY=
# Optional contact identification; does not replace the API key.
OPENALEX_EMAIL=
